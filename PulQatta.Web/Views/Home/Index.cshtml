@{
    Layout = "_Layout";
    var apiUrl = string.IsNullOrEmpty(ViewBag.ApiUrl) ? "" : ViewBag.ApiUrl;
}

<div class="loader-overlay" id="loader">
    <div class="spinner"></div>
</div>

<div class="app-container" id="app" style="display: none;">
    
    <div class="header-section">
        <div class="total-title">Потрачено сегодня</div>
        <div class="total-amount numbers">
            <span id="total-val">0</span>
            <span class="currency">UZS</span>
        </div>
    </div>

    <div class="add-expense-card">
        <div class="input-group">
            <label>Сумма</label>
            <input type="number" id="amount-input" inputmode="numeric" placeholder="Например: 50.000" />
        </div>
        <div class="input-group">
            <label>Категория</label>
            <select id="category-input">
                <option value="Еда">🍔 Еда</option>
                <option value="Транспорт">🚕 Транспорт</option>
                <option value="Покупки">🛍 Покупки</option>
                <option value="Развлечения">🍿 Развлечения</option>
                <option value="Здоровье">💊 Здоровье</option>
                <option value="Прочее">📌 Прочее</option>
            </select>
        </div>
        <div class="input-group">
            <label>Заметка</label>
            <input type="text" id="note-input" placeholder="На что потратили?" />
        </div>
        <button class="btn-primary" id="add-btn">
            Добавить расход
        </button>
    </div>

    <h2 class="section-title">Сегодняшние расходы</h2>
    <div class="expenses-list" id="expenses-container">
        <!-- JS will populate expenses here -->
    </div>

</div>

<!-- Pass the API URL from server configuration to our JS -->
<script>
    window.AppConfig = {
        ApiUrl: '@apiUrl'
    };
</script>
