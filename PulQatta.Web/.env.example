# ==========================================
# PulQatta Frontend (Next.js) Environment Variables
# ==========================================

# Public URL of the backend API (without trailing slash)
# On Netlify: Set this to your Render backend URL (e.g. https://pulqatta-api.onrender.com)
# Locally: Set this to http://localhost:5015 in .env.local
NEXT_PUBLIC_API_URL="https://pulqatta-api.onrender.com"
