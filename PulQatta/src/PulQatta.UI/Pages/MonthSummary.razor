@page "/month"
@using PulQatta.UI.DTOs
@using PulQatta.UI.Services
@using PulQatta.UI.Entities
@inject IApiService ApiService
@inject NavigationManager NavigationManager

<div class="section-header">
    <a href="/" class="section-link"><span class="text-italic-accent" style="font-size: 1.2rem; margin-right: 4px;">&larr;</span> Назад</a>
    <h3 class="section-title">Итоги месяца.</h3>
</div>

@if (_summary == null)
{
    <div style="margin-top: 50px;">
        <p class="subtitle">Загрузка...</p>
    </div>
}
else
{
    var total = _summary.Sum(s => s.TotalAmount);
    var totalUsd = total / 12800m;

    <div class="animate-fade-up animate-delay-1" style="margin-top: 20px; margin-bottom: 40px;">
        <p class="subtitle" style="margin-bottom: 8px;">Всего за месяц</p>
        <h1 class="title-large" style="font-size: 3rem; display: flex; align-items: baseline; justify-content: center; gap: 8px;">
            @total.ToString("N0", new System.Globalization.CultureInfo("de-DE")) 
            <span style="font-size: 1.2rem; font-weight: 700; color: var(--hint-color); letter-spacing: 0.02em;">UZS</span>
        </h1>
        <h2 style="font-size: 1.3rem; color: var(--hint-color); font-weight: 600; margin-top: 4px;">
            $@totalUsd.ToString("N2", new System.Globalization.CultureInfo("en-US"))
        </h2>
    </div>

    @if (_summary.Length == 0)
    {
        <div class="animate-fade-up animate-delay-2" style="padding: 32px 0;">
            <p class="subtitle">В этом месяце трат не было.</p>
        </div>
    }
    else
    {
        <div class="animate-fade-up animate-delay-2">
            @foreach (var item in _summary)
            {
                <div class="expense-item">
                    <div class="expense-details">
                        <span class="expense-category">@GetCategoryName(item.Category)</span>
                    </div>
                    <div style="text-align: right;">
                        @{ var catUsd = item.TotalAmount / 12800m; }
                        <div class="expense-amount">
                            @item.TotalAmount.ToString("N0", new System.Globalization.CultureInfo("de-DE")) 
                            <span style="font-size: 0.9rem; font-weight: 700; color: var(--hint-color); margin-left: 2px;">UZS</span>
                        </div>
                        <div class="expense-note">$@catUsd.ToString("N2", new System.Globalization.CultureInfo("en-US"))</div>
                    </div>
                </div>
            }
        </div>
    }
}

@code {
    private CategorySummaryGetDto[]? _summary;

    protected override async Task OnInitializedAsync()
    {
        _summary = await ApiService.GetMonthSummaryAsync();
    }

    private string GetCategoryName(Category category)
    {
        return category switch
        {
            Category.Food => "Еда",
            Category.Transport => "Транспорт",
            Category.Utilities => "Коммуналка",
            Category.Health => "Здоровье",
            Category.Subscriptions => "Подписки",
            Category.Games => "Игры",
            Category.Clothes => "Одежда",
            Category.Electronics => "Электроника",
            Category.Cafe => "Кафе",
            _ => "Другое"
        };
    }
}
