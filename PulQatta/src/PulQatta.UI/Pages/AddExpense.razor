@page "/add"
@using PulQatta.UI.DTOs
@using PulQatta.UI.Services
@using PulQatta.UI.Entities
@inject IApiService ApiService
@inject NavigationManager NavigationManager

<div class="section-header">
    <a href="/" class="section-link"><span class="text-italic-accent" style="font-size: 1.2rem; margin-right: 4px;">&larr;</span> Назад</a>
    <h3 class="section-title">Новая трата.</h3>
</div>

<div class="animate-fade-up animate-delay-1" style="margin-top: 40px;">
    <input type="text" 
           inputmode="numeric" 
           class="modern-input" 
           placeholder="0" 
           @bind="AmountText" 
           @bind:event="oninput" />

    <input type="text" 
           class="modern-input note-input" 
           placeholder="Заметка (необязательно)" 
           @bind="_note" />
</div>

@if (_isSaving)
{
    <div class="animate-fade-up animate-delay-2" style="margin-top: 40px;">
        <p class="subtitle">Сохранение...</p>
    </div>
}
else
{
    <div class="category-grid animate-fade-up animate-delay-2">
        @foreach (var cat in Enum.GetValues<Category>())
        {
            <button class="category-btn" @onclick="() => SaveExpense(cat)">
                <span>@GetCategoryName(cat)</span>
            </button>
        }
    </div>
}

@code {
    private decimal? _amount;
    private string? _note;
    private bool _isSaving = false;

    private string AmountText
    {
        get => _amount?.ToString("N0", new System.Globalization.CultureInfo("de-DE")) ?? "";
        set
        {
            if (string.IsNullOrWhiteSpace(value))
            {
                _amount = null;
            }
            else
            {
                var clean = value.Replace(".", "").Replace(" ", "");
                if (decimal.TryParse(clean, out var val))
                    _amount = val;
            }
        }
    }

    private async Task SaveExpense(Category category)
    {
        if (_amount == null || _amount <= 0) return;

        _isSaving = true;
        StateHasChanged();

        var success = await ApiService.AddExpenseAsync(_amount.Value, category, _note);
        
        if (success)
        {
            NavigationManager.NavigateTo("/");
        }
        else
        {
            _isSaving = false;
        }
    }

    private string GetCategoryName(Category category)
    {
        return category switch
        {
            Category.Food => "Еда",
            Category.Transport => "Транспорт",
            Category.Utilities => "Жилье",
            Category.Health => "Здоровье",
            Category.Subscriptions => "Подписки",
            Category.Games => "Игры",
            Category.Clothes => "Одежда",
            Category.Electronics => "Техника",
            Category.Cafe => "Кафе",
            _ => "Другое"
        };
    }
}
