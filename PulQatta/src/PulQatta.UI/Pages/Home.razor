@page "/"
@using PulQatta.UI.DTOs
@using PulQatta.UI.Services
@inject IApiService ApiService
@inject NavigationManager NavigationManager

@if (_summary == null)
{
    <div style="margin-top: 50px;">
        <p class="subtitle">Загрузка...</p>
    </div>
}
else
{
    <div class="animate-fade-up animate-delay-1" style="margin-top: 20px;">
        <p class="subtitle" style="margin-bottom: 8px;">Сегодня потрачено</p>
        @{ var totalUsd = _summary.Total / 12800m; }
        <h1 class="title-large" style="display: flex; align-items: baseline; gap: 8px;">
            @_summary.Total.ToString("N0", new System.Globalization.CultureInfo("de-DE")) 
            <span style="font-size: 1.4rem; font-weight: 700; color: var(--hint-color); letter-spacing: 0.02em;">UZS</span>
        </h1>
        <h2 style="font-size: 1.5rem; color: var(--hint-color); font-weight: 600; margin-top: 4px;">
            $@totalUsd.ToString("N2", new System.Globalization.CultureInfo("en-US"))
        </h2>
    </div>

    <button class="btn-primary animate-fade-up animate-delay-2" @onclick='() => NavigationManager.NavigateTo("/add")'>
        <span>Добавить трату</span>
        <span class="btn-icon-circle">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
        </span>
    </button>

    <div class="animate-fade-up animate-delay-3">
        <div class="section-header">
            <h3 class="section-title">Последние.</h3>
            <a href="/month" class="section-link">Итоги месяца <span class="text-italic-accent" style="font-size: 1.2rem; margin-left: 4px;">&rarr;</span></a>
        </div>
        
        @if (_summary.Expenses.Length == 0)
        {
            <div style="padding: 32px 0;">
                <p class="subtitle">Сегодня трат не было.</p>
            </div>
        }
        else
        {
            <div>
                @foreach (var expense in _summary.Expenses)
                {
                    <div class="expense-item">
                        <div class="expense-details">
                            <span class="expense-category">@GetCategoryName(expense.Category)</span>
                            @if (!string.IsNullOrEmpty(expense.Note))
                            {
                                <span class="expense-note">@expense.Note</span>
                            }
                        </div>
                        <div style="display: flex; align-items: center; gap: 12px; text-align: right;">
                            @{ var expUsd = expense.Amount / 12800m; }
                            <div>
                                <div class="expense-amount">
                                    @expense.Amount.ToString("N0", new System.Globalization.CultureInfo("de-DE")) 
                                    <span style="font-size: 0.9rem; font-weight: 700; color: var(--hint-color); margin-left: 2px;">UZS</span>
                                </div>
                                <div class="expense-note">$@expUsd.ToString("N2", new System.Globalization.CultureInfo("en-US"))</div>
                            </div>
                            <button @onclick="() => DeleteExpense(expense.Id)" style="background: transparent; border: none; padding: 4px; cursor: pointer; color: var(--hint-color); transition: color 0.2s;">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    private ExpenseTodaySummaryGetDto? _summary;

    protected override async Task OnInitializedAsync()
    {
        _summary = await ApiService.GetTodaySummaryAsync();
        if (_summary == null)
        {
            _summary = new ExpenseTodaySummaryGetDto { Total = 0 };
        }
    }

    private async Task DeleteExpense(int id)
    {
        var success = await ApiService.DeleteExpenseAsync(id);
        if (success)
        {
            _summary = await ApiService.GetTodaySummaryAsync();
            StateHasChanged();
        }
    }

    private string GetCategoryName(PulQatta.UI.Entities.Category category)
    {
        return category switch
        {
            PulQatta.UI.Entities.Category.Food => "Еда",
            PulQatta.UI.Entities.Category.Transport => "Транспорт",
            PulQatta.UI.Entities.Category.Utilities => "Коммуналка",
            PulQatta.UI.Entities.Category.Health => "Здоровье",
            PulQatta.UI.Entities.Category.Subscriptions => "Подписки",
            PulQatta.UI.Entities.Category.Games => "Игры",
            PulQatta.UI.Entities.Category.Clothes => "Одежда",
            PulQatta.UI.Entities.Category.Electronics => "Электроника",
            PulQatta.UI.Entities.Category.Cafe => "Кафе",
            _ => "Другое"
        };
    }
}
