# Ignore all bin/ and obj/ folders recursively
**/[Bb]in/
**/[Oo]bj/

# Ignore user-specific and IDE-related files recursively
**/*.user
**/*.suo
**/*.vspx
**/*.vsmdi
.vs/
.vscode/
.idea/

# Ignore packages, build artifacts and NuGet outputs
packages/
**/packages/
**/*.nupkg
**/artifacts/

# Ignore test results
TestResults/
**/*.trx
**/*.coverage
**/*.testsettings

# Ignore local DB files
**/*.db
**/*.sqlite
**/*.sqlite3

# Ignore design and media files
Design/
**/*.psd
**/*.ai
**/*.xd

# Ignore Xamarin/MAUI/Android/iOS output files
**/*.apk
**/*.aab
**/*.ipa
**/*.dll
**/*.pdb
**/*.so
**/*.jar
**/*.dex

# Ignore temp, backup, and system files
**/*~
**/*.tmp
**/*.bak
**/*.swp
**/*.swo
.DS_Store
Thumbs.db
ehthumbs.db

# Ignore environment and config secrets
.env
.env.*
!.env.example
deploy/social.secrets.env
deploy/search.ai.env
deploy/*.secrets.env
secrets.json
appsettings.*.local.json

# Single consolidated secrets file (keep the *.example.json template committed)
appsettings.Secrets.json
!appsettings.Secrets.example.json

# Accidental local build dumps
_build_check/
.test-build/

# Uploaded user media (keep folders via .gitkeep)
**/wwwroot/avatars/*
!**/wwwroot/avatars/.gitkeep
**/wwwroot/stylefeed/*
!**/wwwroot/stylefeed/.gitkeep

# Local Serilog rolling files
**/logs/