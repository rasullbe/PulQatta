# ==========================================
# PulQatta Backend Environment Variables
# ==========================================

# Port (Render assigns PORT automatically, default is 10000)
PORT=10000
ASPNETCORE_ENVIRONMENT=Production

# Database (Neon PostgreSQL)
# Option A: Standard Npgsql key-value format:
ConnectionStrings__Default="Host=ep-xyz-pooler.region.aws.neon.tech;Port=5432;Database=neondb;Username=neondb_owner;Password=your_neon_password;SSL Mode=Require;Trust Server Certificate=true;"
# Option B: Neon URI format (auto-parsed by backend):
# DATABASE_URL="postgres://neondb_owner:your_neon_password@ep-xyz-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Telegram Bot Token from @BotFather
BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ"

# Telegram Webhook Secret Token (arbitrary random string, letters/numbers/underscores/hyphens, 1-256 chars)
TELEGRAM_WEBHOOK_SECRET="your_random_secret_token_here_12345"

# Public Backend URL (used for registering Telegram webhook)
# Leave empty for local development to use Polling mode instead of Webhook
PUBLIC_URL="https://pulqatta-api.onrender.com"

# Frontend Origin (Netlify URL used for CORS and Telegram Mini App button)
FRONTEND_ORIGIN="https://pulqatta.netlify.app"
